<style>
  /* Design tokens. Declared on real shadow-tree elements — `:root` matches
     nothing inside a shadow root, so it must not be used here. */
  #dialog, #overlay {
    --bg: {{ t.header_bg }}; --ink: {{ t.ink }}; --panel: {{ t.panel }};
    --line: {{ t.dialog_border }}; --soft: {{ t.panel_border }}; --accent: {{ t.accent }};
    --radius: {{ t.dialog_radius }}; --shadow: {{ t.dialog_shadow }};
    --row-bg: {{ t.row_bg }}; --row-border: {{ t.row_border }};
    --ghost-bg: {{ t.ghost_bg }}; --ghost-border: {{ t.ghost_border }}; --ghost-ink: {{ t.ghost_ink }};
    --input-bg: {{ t.input_bg }}; --input-border: {{ t.input_border }};
    --badge-bg: {{ t.badge_bg }}; --badge-ink: {{ t.badge_ink }};
    --muted: {{ t.muted }}; --faint: {{ t.faint }}; --code: {{ t.code_ink }};
    --ok: {{ t.ok }}; --err: {{ t.err }};
    --mono: {{ t.font_mono }};
  }
  * { box-sizing: border-box; }

  /* Runtime dark theme override (toggled via settings). */
  #dialog.dark, #overlay.dark {
    --bg: #1e293b; --ink: #e2e8f0; --panel: #0f172a;
    --line: #334155; --soft: #334155; --accent: #22c55e;
    --radius: 12px; --shadow: 0 4px 24px rgba(0,0,0,.25), 0 1px 4px rgba(0,0,0,.1);
    --row-bg: #0f172a; --row-border: #243049;
    --ghost-bg: #0f172a; --ghost-border: #334155; --ghost-ink: #e2e8f0;
    --input-bg: #0f172a; --input-border: #334155;
    --badge-bg: #FFD700; --badge-ink: #1E3A5F;
    --muted: #94a3b8; --faint: #64748b; --code: #a7f3d0;
    --ok: #22c55e; --err: #f87171;
  }
  #dialog.dark .box button.active { color: #ffffff; }
  #dialog.dark .settings .save { color: #ffffff; }

  #overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; cursor: crosshair; pointer-events: auto; fill: {{ t.overlay_dim }}; }
  #ocean { fill: rgba(0, 0, 0, .12); }
  #island { fill: {{ t.island_fill }}; stroke: {{ t.island_stroke }}; stroke-width: 2; }
  #overlay.frozen { cursor: default; }

  /* ── toolbox shell ───────────────────────────────────────────── */
  #dialog {
    position: fixed; bottom: 20px; right: 20px; width: 360px; max-width: calc(100vw - 40px);
    font-family: {{ t.font_ui }}; font-size: 13px; line-height: 1.3; color: var(--ink);
    pointer-events: auto; z-index: 2147483647;
  }
  #dialog.closing { animation: ctp-fadeOut .25s ease forwards; }
  #dialog.frozen .box { border-color: var(--ok); }
  @keyframes ctp-fadeOut { from { opacity: 1 } to { opacity: 0; transform: translateY(-8px) } }

  /* ── toolbar ─────────────────────────────────────────────────── */
  .box { width: 100%; height: 52px; display: flex; align-items: center; gap: 8px; padding: 10px 12px; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); cursor: move; user-select: none; }
  .tool.open .box { border-radius: var(--radius) var(--radius) 0 0; border-bottom: 0; }
  .box button { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 8px; background: rgba(255, 255, 255, .55); color: var(--ink); cursor: pointer; flex: none; font: inherit; }
  .box button:hover { background: rgba(255, 255, 255, .85); }
  .box button.active { background: var(--accent); color: {{ t.accent_ink }}; }
  .box button svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .box .copy { flex: 1; display: inline-flex; align-items: center; justify-content: center; height: 32px; padding: 0 12px; border: 0; border-radius: 999px; background: var(--accent); color: {{ t.accent_ink }}; font-weight: 700; font-size: 12px; cursor: pointer; }
  .box .copy:hover { background: {{ t.accent_hover }}; }
  #addBtn { font-size: 18px; font-weight: 700; line-height: 1; }
  .box button:disabled { opacity: .4; cursor: not-allowed; }
  .box button:disabled:hover { background: rgba(255, 255, 255, .55); }

  /* ── settings ────────────────────────────────────────────────── */
  /* The panel floats above the bar. A fixed auto-height box keeps its top edge
     when it grows, so the settings section must be out of flow — otherwise the
     panel opens off the bottom of the viewport. */
  .settings { position: absolute; bottom: 100%; left: 0; right: 0; width: 100%; height: 400px; max-height: calc(100vh - 96px); display: flex; flex-direction: column; overflow: hidden; margin: 0; background: var(--panel); border: 1px solid var(--line); border-bottom: 0; border-radius: var(--radius) var(--radius) 0 0; box-shadow: var(--shadow); padding: 14px 16px; text-align: left; font-family: {{ t.font_ui }}; }
  .tool.open .box { border-radius: 0 0 var(--radius) var(--radius); }
  .settings[hidden] { display: none; }
  .settings h2 { margin: 0 0 12px; font-size: 13px; font-weight: 600; letter-spacing: -.01em; display: flex; align-items: center; justify-content: space-between; flex: 0 0 auto; }
  .save-state { font-size: 10px; font-weight: 400; color: var(--ok); }
  .settings .tabs { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 12px; border-bottom: 1px solid var(--soft); padding-bottom: 8px; flex: 0 0 auto; }
  .settings .tab { display: inline-flex; align-items: center; justify-content: center; width: auto; height: 26px; padding: 0 10px; border: 1px solid transparent; border-radius: 6px; background: transparent; color: var(--muted); font: inherit; font-size: 12px; white-space: nowrap; cursor: pointer; }
  .settings .tab:hover { color: var(--ghost-ink); background: var(--ghost-bg); }
  .settings .tab.active { color: var(--ink); background: var(--ghost-bg); border-color: var(--soft); font-weight: 600; }
  .panel { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding-right: 2px; }
  .panel[hidden] { display: none; }

  /* ── style panel ─────────────────────────────────────────────── */
  .presets { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
  .settings .chip { display: inline-flex; align-items: center; justify-content: center; width: auto; height: 26px; padding: 0 10px; border: 1px solid var(--ghost-border); border-radius: 6px; background: var(--ghost-bg); color: var(--ghost-ink); font: inherit; font-size: 11.5px; white-space: nowrap; cursor: pointer; }
  .settings .chip:hover { background: var(--row-bg); border-color: var(--ghost-border); }
  .checks { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 12px; max-height: 150px; overflow: auto; margin-bottom: 12px; padding-right: 2px; font-size: 12px; color: var(--ghost-ink); }
  .checks label { display: flex; align-items: center; gap: 7px; cursor: pointer; }
  .checks input { width: 13px; height: 13px; margin: 0; accent-color: var(--accent); }
  .custom-label { font-size: 11px; color: var(--muted); margin-bottom: 4px; }
  .settings textarea { width: 100%; min-height: 44px; padding: 6px 8px; border: 1px solid var(--input-border); border-radius: 6px; background: var(--input-bg); color: var(--ink); font-family: var(--mono); font-size: 11px; resize: vertical; }
  .settings textarea:focus { outline: none; border-color: var(--faint); }

  /* ── path / output / toolbar panels ──────────────────────────── */
  .row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; font-size: 12px; color: var(--ghost-ink); }
  .row select { width: 150px; height: 28px; padding: 0 8px; border: 1px solid var(--input-border); border-radius: 6px; background: var(--input-bg); color: var(--ink); font: inherit; font-size: 12px; cursor: pointer; }
  .row label { display: flex; align-items: center; gap: 7px; cursor: pointer; }
  .row input[type="checkbox"] { width: 13px; height: 13px; margin: 0; accent-color: var(--accent); }

  .settings .btn { display: inline-flex; align-items: center; justify-content: center; width: auto; height: 28px; padding: 0 12px; border: 1px solid var(--ghost-border); border-radius: 6px; background: var(--ghost-bg); color: var(--ghost-ink); font: inherit; font-size: 12px; white-space: nowrap; cursor: pointer; }
  .settings .btn:hover { background: var(--row-bg); }
  .settings .btn.save { background: var(--accent); color: {{ t.accent_ink }}; border-color: var(--accent); font-weight: 700; }
  .settings .btn.save:hover { background: {{ t.accent_hover }}; }
  .settings .btn:disabled { opacity: .45; cursor: not-allowed; }
  .settings .btn.full { width: 100%; margin-top: 10px; }
  .side-div { border-top: 1px solid var(--soft); margin: 6px 0; }

  /* ── path preview panel ──────────────────────────────────────── */
  .settings .path-text { flex: 1; min-width: 0; min-height: 28px; display: flex; align-items: center; padding: 4px 8px; border: 1px solid var(--soft); border-radius: 6px; background: var(--ghost-bg); color: var(--code); font-family: var(--mono); font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #path-display { white-space: pre-wrap; overflow: auto; max-height: 96px; align-items: flex-start; line-height: 1.45; }
  .settings .preview-list { display: flex; flex-direction: column; gap: 8px; max-height: 220px; overflow: auto; margin: 8px 0 10px; padding-right: 2px; }
  .settings .preview-row { display: flex; gap: 8px; align-items: flex-start; padding: 8px; border: 1px solid var(--row-border); border-radius: 8px; background: var(--row-bg); }
  .settings .preview-row:hover { border-color: var(--accent); }
  .settings .preview-row .n { width: 20px; height: 20px; flex: none; display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; background: var(--badge-bg); color: var(--badge-ink); font-size: 11px; font-weight: 700; margin-top: 3px; }
  .settings .preview-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .settings .row-actions { display: flex; gap: 6px; }
  .settings .row-actions button { display: inline-flex; align-items: center; justify-content: center; width: auto; height: 22px; padding: 0 9px; border: 1px solid var(--ghost-border); border-radius: 6px; background: var(--ghost-bg); color: var(--ghost-ink); font: inherit; font-size: 10.5px; font-weight: 600; white-space: nowrap; cursor: pointer; }
  .settings .row-actions button:hover { border-color: var(--accent); color: var(--ink); }
  .settings .row-actions button.ok { background: var(--ok); border-color: var(--ok); color: #ffffff; }
  /* The row's own × — narrower than the text buttons beside it, and destructive. */
  .settings .row-actions .rm-one { width: 26px; padding: 0; font-size: 13px; line-height: 1; }
  .settings .row-actions .rm-one:hover { border-color: var(--err); color: var(--err); background: var(--row-bg); }
  .settings .preview-row.expanded .path-text { white-space: normal; word-break: break-all; overflow: visible; }
  .settings .preview-notes { display: flex; gap: 4px; flex-wrap: wrap; align-items: center; }
  .settings .preview-notes:empty { display: none; }
  .settings .note { display: inline-flex; align-items: center; gap: 4px; max-width: 100%; font-size: 10px; color: #78350f; background: #fffbeb; border: 1px solid #fde68a; border-radius: 999px; padding: 1px 4px 1px 7px; }
  .settings .note span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .settings .note button { display: inline-flex; align-items: center; justify-content: center; width: 14px; height: 14px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: #b45309; font-size: 11px; line-height: 1; cursor: pointer; }
  .settings .note button:hover { background: #fde68a; }
  .settings .note-editor { display: flex; gap: 4px; align-items: center; }
  .settings .note-input { flex: 1; min-width: 0; height: 24px; padding: 0 7px; border: 1px solid var(--input-border); border-radius: 6px; background: var(--panel); color: var(--ink); font: inherit; font-size: 11px; }
  .settings .note-input:focus { outline: none; border-color: var(--accent); }
  .settings .note-save { flex: none; display: inline-flex; align-items: center; justify-content: center; width: auto; height: 24px; padding: 0 9px; border: 0; border-radius: 6px; background: var(--accent); color: {{ t.accent_ink }}; font: inherit; font-size: 11px; font-weight: 600; cursor: pointer; }
  .settings .preview-meta { display: flex; gap: 4px; flex-wrap: wrap; align-items: center; }
  .settings .meta { font-size: 10px; color: var(--muted); background: var(--row-bg); border: 1px solid var(--soft); border-radius: 999px; padding: 1px 7px; white-space: nowrap; }
  .settings .preview-actions { display: none; align-items: center; justify-content: space-between; gap: 8px; }
  .settings .preview-actions.open { display: flex; }
  .settings .preview-actions .group { display: flex; gap: 8px; }
</style>
<svg id="overlay" xmlns="http://www.w3.org/2000/svg"><path id="ocean" fill-rule="evenodd" d=""/><path id="island" d=""/></svg>
<div id="dialog" class="tool">
  <div class="box" id="dialog-header">
    <button id="stepBackBtn" title="To child" aria-label="To child"><svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg></button>
    <button id="stepNextBtn" title="To parent" aria-label="To parent"><svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></button>
    <button id="configBtn" title="Settings" aria-label="Settings" aria-expanded="false" aria-controls="settingsPanel"><svg viewBox="0 0 24 24"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></button>
    <button id="addBtn" title="Add to picked paths" aria-label="Add to picked paths">+</button>
    <button class="copy" id="copyBtn" title="Copy path" aria-label="Copy path">Copy path</button>
    <button id="moveBtn" title="Drag to move" aria-label="Drag to move"><svg viewBox="0 0 24 24"><path d="M12 3v18M3 12h18M9 6l3-3 3 3M9 18l3 3 3-3M6 9l-3 3 3 3M18 9l3 3-3 3"/></svg></button>
    <button class="close" id="quitBtn" title="Quit" aria-label="Quit"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  </div>

  <section class="settings" id="settingsPanel" hidden>
    <h2>Settings <span class="save-state" id="saveState">Saved</span></h2>
    <div class="tabs">
      <button class="tab" data-tab="style">Style</button>
      <button class="tab" data-tab="config">Config</button>
      <button class="tab" data-tab="preview">Path Preview</button>
    </div>

    <div class="panel" data-panel="style" hidden>
      <div class="presets">
        <button class="chip preset-btn" data-preset="color">color only</button>
        <button class="chip preset-btn" data-preset="essentials">essentials</button>
        <button class="chip preset-btn" data-preset="typography">typography</button>
        <button class="chip preset-btn" data-preset="box">box</button>
        <button class="chip preset-btn" data-preset="all">all</button>
        <button class="chip preset-btn" data-preset="clear">clear</button>
      </div>
      <div class="checks" id="config-checks"></div>
      <div class="custom-label">Custom (comma-separated):</div>
      <textarea id="config-custom" rows="2" placeholder="e.g. color, background-color, font-size"></textarea>
    </div>

    <div class="panel" data-panel="config" hidden>
      <div class="row"><span>Default format</span><select id="format-select"><option value="context">Context</option><option value="classic-context">Classic Context</option><option value="xpath">XPath</option><option value="css">CSS</option><option value="pw">Playwright</option></select></div>
      <div class="side-div"></div>
      <div class="row"><span>Separator</span><select id="sep-select"><option value="newline">newline</option><option value="numbered">numbered</option><option value="comma">comma</option><option value="json">JSON</option><option value="custom">custom</option></select></div>
      <div class="row"><span>Custom separator</span><input id="sep-custom" type="text" placeholder="e.g. \\n\\n or ---" style="width:150px;height:28px;"></div>
      <div class="row"><label><input type="checkbox" id="closeAfterCopy"> close after copy</label></div>
      <div class="row"><label><input type="checkbox" id="opt-instantCopy"> instant copy on click</label></div>
      <div class="row"><label><input type="checkbox" id="opt-showPathOnCopyHover" checked> show path on hovering on copy button</label></div>
      <div class="row"><label><input type="checkbox" id="opt-darkTheme"> dark theme</label></div>
      <div class="row"><span>Max depth</span><input id="max-depth" type="number" min="1" max="200" style="width:80px;height:28px;"></div>
      <div class="side-div"></div>
      <div class="row"><label><input type="checkbox" id="opt-child" checked> to child</label></div>
      <div class="row"><label><input type="checkbox" id="opt-parent" checked> to parent</label></div>
      <div class="row"><label><input type="checkbox" id="opt-move" checked> show move button</label></div>
      <div class="row"><label><input type="checkbox" id="opt-settings" checked> show settings</label></div>
      <div class="row"><label><input type="checkbox" id="opt-info" checked> show element info</label></div>
      <div class="side-div"></div>
      <div class="row"><label><input type="checkbox" id="opt-corner-tl"> show tl in hover</label></div>
      <div class="row"><label><input type="checkbox" id="opt-corner-tr"> show tr in hover</label></div>
      <div class="row"><label><input type="checkbox" id="opt-corner-bl"> show bl in hover</label></div>
      <div class="row"><label><input type="checkbox" id="opt-corner-br"> show br in hover</label></div>
      <div class="side-div"></div>
      <div class="row"><span style="font-weight:600">Context</span></div>
      <div class="row"><label><input type="checkbox" id="opt-includeURL" checked disabled> Page URL (always on, cannot disable)</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includeSource" checked> Source file path</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includeComponentChain" checked> Component chain</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includeUsage"> Rendered inside</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includeViewport" checked> Viewport size</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includeTitle"> Page title</label></div>
      <div class="side-div"></div>
      <div class="row"><span style="font-weight:600">Element</span></div>
      <div class="row"><label><input type="checkbox" id="opt-includeSelector" checked> CSS selector</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includeDOMPath"> DOM path</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includeClasses" checked> Classes</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includeText" checked> Text content</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includeAttributes"> Attributes</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includePosition"> Position and size</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includeSection"> Section heading</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includeNearby"> Nearby text</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includeHTML"> HTML snippet</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includeStyles"> Computed styles</label></div>
      <div class="side-div"></div>
      <div class="row"><span style="font-weight:600">Screenshot</span></div>
      <div class="row"><label><input type="checkbox" id="opt-includeScreenshot" checked> Capture with new annotation</label></div>
      <div class="row"><label><input type="checkbox" id="opt-includeImageBase64"> Image base64</label></div>
      <div class="row"><span>Image resolution (%)</span><input type="range" id="imgreso-range" min="0" max="100" step="1" value="50" style="width:120px"><span id="imgreso-val" style="width:38px;text-align:right">50%</span></div>
      <div class="row"><span>Image compression (%)</span><input type="range" id="imgcomp-range" min="0" max="100" step="1" value="40" style="width:120px"><span id="imgcomp-val" style="width:38px;text-align:right">40%</span></div>
      <div class="row"><label><input type="checkbox" id="opt-includeScreenshotCompact"> Include in compact output</label></div>
    </div>

    <div class="panel" data-panel="preview" hidden>
      <span class="path-text" id="path-display">Hover over an element…</span>
      <div class="preview-meta"><span class="meta" id="el-info"></span></div>
      <div class="preview-list" id="queue-list"></div>
      <div class="preview-actions" id="multi-actions">
        <span class="meta" id="queue-count">0 paths</span>
        <div class="group">
          <button class="btn" id="clearBtn">Clear</button>
          <button class="btn save" id="copyAllBtn" disabled>Copy All</button>
        </div>
      </div>
      <button class="btn full" id="copyIdBtn" disabled>Copy Selected id</button>
    </div>
  </section>
</div>
